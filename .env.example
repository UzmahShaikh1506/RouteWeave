# ============================================================
# RouteWeave — Environment Variables
#
# Copy this file to .env and update the values:
#   cp .env.example .env
#
# NEVER commit .env to version control!
# ============================================================

# PostgreSQL password
DB_PASSWORD=routeweave_secret

# Optional: API key to protect POST /jobs in production
# Leave unset for local development (auth disabled)
# SECURITY: When enabled, you MUST terminate TLS at a reverse proxy.
# API_KEY=your-secret-production-key

# Optional: Admin key for the admin dashboard and management endpoints
# Leave unset for local development (admin disabled)
# ADMIN_KEY=your-secret-admin-key

# Optional: CORS origins (comma-separated) for production.
# Leave unset for localhost development.
# CORS_ORIGINS=https://routeweave.example.com,https://app.routeweave.example.com

# Optional: Render/Fly.io deploy hook URL (used in CI/CD)
# RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxxxx?key=xxxxx
